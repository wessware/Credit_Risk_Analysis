   "metadata": {},
   "outputs": [],
   "source": [
    "df.replace([np.inf, -np.inf], np.nan, inplace=True)\n",
    "\n",
    "for col in df.select_dtypes('number').columns: \n",
    "    Q1=df[col].quantile(0.25); \n",
    "    Q3=df[col].quantile(0.75); \n",
    "    IQR=Q3-Q1; \n",
    "    \n",
    "    df[col]=df[col].clip(lower=Q1-1.5*IQR, upper=Q3+1.5*IQR)\n",
    "\n",
    "df.fillna(df.median(numeric_only=True), inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "b73103bf",
   "metadata": {},
   "outputs": [],
   "source": [
    "cat_cols = [\"Payment_of_Min_Amount\", \"Credit_Mix\", \"Payment_Behaviour\", \"Borrower_Tier\"]\n",
    "\n",
    "df[cat_cols] = df[cat_cols].astype(\"category\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
