   "metadata": {},
   "outputs": [],
   "source": [
    "corr = X.corr(numeric_only=True).abs()\n",
    "\n",
    "upper = corr.where(np.triu(np.ones(corr.shape), k=1).astype(bool))\n",
    "\n",
    "to_drop = [col for col in upper.columns if any(upper[col] > 0.85)]\n",
    "\n",
    "X = X.drop(columns=to_drop)"
   ]
